# Public repo: ignore EVERYTHING by default, then allow only the code.
# Personal data (Sessions/, Daily/, Exercises/, Inbox/, any other note) stays local.
/*
!/.gitignore
!/README.md
!/Dashboard.md
!/Scripts/
!/Templates/
!/.obsidian/

# Obsidian local state
/.obsidian/workspace*.json
/.obsidian/cache
/.obsidian/plugins/*/main.js
/.obsidian/plugins/*/styles.css

# Google Drive / OS clutter
desktop.ini
.DS_Store
*.tmp
